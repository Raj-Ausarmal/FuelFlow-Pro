# Copy this file to .env and replace each placeholder with the value from
# your Twilio Console. Never commit the real .env file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006

# Use a long, private random value for local Flask sessions.
SECRET_KEY=replace_with_a_long_random_secret

# Email OTP configuration (Gmail example). Create a Gmail App Password; do
# not use your normal Gmail password and never commit the real .env file.
SMTP_HOST=smtp.gmail.com
# Use 465 for SSL, or 587 for STARTTLS if your network blocks port 465.
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
